{
  "name": "thinkstruct-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Patent explorer: linked results / CPC / timeline views over the search API",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('../app/static/assets',{recursive:true,force:true});require('fs').rmSync('../app/static/index.html',{force:true})\"",
    "build": "npm run typecheck && npm run clean && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
